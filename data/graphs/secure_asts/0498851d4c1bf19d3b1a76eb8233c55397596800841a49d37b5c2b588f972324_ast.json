								"nodeType" : "InlineAssembly",
								"operations" : "{\n    mstore(0x60, self_slot)\n    let low := 0\n    let high := sub(sload(self_slot), 1)\n    let mid := 0\n    jumpi(unsorted, iszero(isSorted))\n    sorted:\n    jumpi(done, gt(low, high))\n    mid := div(add(low, high), 2)\n    jumpi(setH, lt(value, sload(add(keccak256(0x60, 0x20), mid))))\n    jumpi(setL, gt(value, sload(add(keccak256(0x60, 0x20), mid))))\n    found := 1\n    index := mid\n    jump(done)\n    setH:\n    high := sub(mid, 1)\n    jump(sorted)\n    setL:\n    low := add(mid, 1)\n    jump(sorted)\n    unsorted:\n    jumpi(loop, iszero(eq(sload(add(keccak256(0x60, 0x20), low)), value)))\n    found := 1\n    index := low\n    jump(done)\n    loop:\n    low := add(low, 1)\n    jumpi(unsorted, lt(low, sload(self_slot)))\n    done:\n}",
								"src" : "2807:852:0"
