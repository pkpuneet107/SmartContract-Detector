								"id" : 47,
								"nodeType" : "InlineAssembly",
								"operations" : "{\n    mstore(0x60, self_slot)\n    for {\n        let i := 0\n    }\n    lt(i, sload(self_slot))\n    {\n        i := add(i, 1)\n    }\n    {\n        term := sload(add(keccak256(0x60, 0x20), div(i, 4)))\n        remainder := mod(i, 4)\n        for {\n            let j := 0\n        }\n        lt(j, mul(remainder, 2))\n        {\n            j := add(j, 1)\n        }\n        {\n            term := div(term, 4294967296)\n        }\n        term := and(0x000000000000000000000000000000000000000000000000ffffffffffffffff, term)\n        switch eq(i, 0)\n        case 1 {\n            minValue := term\n        }\n        switch gt(minValue, term)\n        case 1 {\n            minValue := term\n        }\n    }\n}",
								"src" : "3257:619:0"
