											"operations" : "{\n    let commonIndex := mul(0x20, add(1, i))\n    let maskValue := mload(add(mask, commonIndex))\n    mstore(add(array, commonIndex), or(and(not(maskValue), mload(add(array, commonIndex))), and(maskValue, mload(add(desired, commonIndex)))))\n}",
