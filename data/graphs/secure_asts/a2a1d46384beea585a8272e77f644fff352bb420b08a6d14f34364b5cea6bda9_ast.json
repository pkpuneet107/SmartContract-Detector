								"nodeType" : "InlineAssembly",
								"operations" : "{\n    mstore(0x60, self_slot)\n    switch isSorted\n    case 1 {\n        let high := sub(sload(self_slot), 1)\n        let mid := 0\n        let low := 0\n        for {\n        }\n        iszero(gt(low, high))\n        {\n        }\n        {\n            mid := div(add(low, high), 2)\n            term := sload(add(keccak256(0x60, 0x20), div(mid, 2)))\n            switch mod(mid, 2)\n            case 1 {\n                for {\n                    let j := 0\n                }\n                lt(j, 4)\n                {\n                    j := add(j, 1)\n                }\n                {\n                    term := div(term, 4294967296)\n                }\n            }\n            term := and(term, 0x00000000000000000000000000000000ffffffffffffffffffffffffffffffff)\n            switch lt(term, value)\n            case 1 {\n                low := add(mid, 1)\n            }\n            case 0 {\n                switch gt(term, value)\n                case 1 {\n                    high := sub(mid, 1)\n                }\n                case 0 {\n                    found := 1\n                    index := mid\n                    low := add(high, 1)\n                }\n            }\n        }\n    }\n    case 0 {\n        for {\n            let i := 0\n        }\n        lt(i, sload(self_slot))\n        {\n            i := add(i, 1)\n        }\n        {\n            term := sload(add(keccak256(0x60, 0x20), div(i, 2)))\n            switch mod(i, 2)\n            case 1 {\n                for {\n                    let j := 0\n                }\n                lt(j, 4)\n                {\n                    j := add(j, 1)\n                }\n                {\n                    term := div(term, 4294967296)\n                }\n            }\n            term := and(term, 0x00000000000000000000000000000000ffffffffffffffffffffffffffffffff)\n            switch eq(term, value)\n            case 1 {\n                found := 1\n                index := i\n                i := sload(self_slot)\n            }\n        }\n    }\n}",
