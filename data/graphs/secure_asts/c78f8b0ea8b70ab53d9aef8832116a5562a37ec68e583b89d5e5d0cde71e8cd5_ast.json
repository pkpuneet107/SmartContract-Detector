								"operations" : "{\n    let m := mload(0x40)\n    calldatacopy(m, 0, calldatasize())\n    let success := delegatecall(gas(), _trg, m, calldatasize(), m, 0x40)\n    switch success\n    case 0 {\n        revert(0, 0)\n    }\n    default {\n        return(m, 0x40)\n    }\n}",
