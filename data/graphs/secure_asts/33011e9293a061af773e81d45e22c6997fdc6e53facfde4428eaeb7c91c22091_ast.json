								"operations" : "{\n    mstore(0x60, self_slot)\n    for {\n        let i := 0\n    }\n    lt(i, sload(self_slot))\n    {\n        i := add(i, 1)\n    }\n    {\n        term := sload(add(keccak256(0x60, 0x20), div(i, 8)))\n        remainder := mod(i, 8)\n        for {\n            let j := 0\n        }\n        lt(j, remainder)\n        {\n            j := add(j, 1)\n        }\n        {\n            term := div(term, 4294967296)\n        }\n        term := and(0x00000000000000000000000000000000000000000000000000000000ffffffff, term)\n        sum := add(term, sum)\n    }\n}",
