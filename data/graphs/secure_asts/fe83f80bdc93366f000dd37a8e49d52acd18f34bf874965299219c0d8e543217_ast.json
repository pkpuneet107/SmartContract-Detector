								"operations" : "{\n    mstore(0x60, self_slot)\n    minValue := sload(keccak256(0x60, 0x20))\n    for {\n        let i := 0\n    }\n    lt(i, sload(self_slot))\n    {\n        i := add(i, 1)\n    }\n    {\n        switch gt(sload(add(keccak256(0x60, 0x20), i)), minValue)\n        case 0 {\n            minValue := sload(add(keccak256(0x60, 0x20), i))\n        }\n    }\n}",
