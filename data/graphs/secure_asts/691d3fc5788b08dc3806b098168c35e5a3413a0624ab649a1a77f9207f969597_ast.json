								"operations" : "{\n    {\n        let i := 0\n        let words := div(add(btsLen, 31), 32)\n        let rOffset := btsPtr\n        let wOffset := add(tgt, 0x20)\n        tag_loop:\n        jumpi(end, eq(i, words))\n        {\n            let offset := mul(i, 0x20)\n            mstore(add(wOffset, offset), mload(add(rOffset, offset)))\n            i := add(i, 1)\n        }\n        jump(tag_loop)\n        end:\n        mstore(add(tgt, add(0x20, mload(tgt))), 0)\n    }\n}",
