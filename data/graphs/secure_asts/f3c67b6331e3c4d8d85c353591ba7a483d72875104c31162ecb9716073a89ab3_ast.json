								"id" : 1395,
								"nodeType" : "InlineAssembly",
								"operations" : "{\n    mstore(0x60, self_slot)\n    switch isSorted\n    case 1 {\n        let high := sub(sload(self_slot), 1)\n        let mid := 0\n        let low := 0\n        for {\n        }\n        iszero(gt(low, high))\n        {\n        }\n        {\n            mid := div(add(low, high), 2)\n            switch lt(sload(add(keccak256(0x60, 0x20), mid)), value)\n            case 1 {\n                low := add(mid, 1)\n            }\n            case 0 {\n                switch gt(sload(add(keccak256(0x60, 0x20), mid)), value)\n                case 1 {\n                    high := sub(mid, 1)\n                }\n                case 0 {\n                    found := 1\n                    index := mid\n                    low := add(high, 1)\n                }\n            }\n        }\n    }\n    case 0 {\n        for {\n            let low := 0\n        }\n        lt(low, sload(self_slot))\n        {\n            low := add(low, 1)\n        }\n        {\n            switch eq(sload(add(keccak256(0x60, 0x20), low)), value)\n            case 1 {\n                found := 1\n                index := low\n                low := sload(self_slot)\n            }\n        }\n    }\n}",
								"src" : "17785:999:0"
