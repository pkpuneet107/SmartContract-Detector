			"contractDependencies" : [],
			"contractKind" : "contract",
			"documentation" : "@title ERC1363Spender interface\r\n@author Vittorio Minacori (https://github.com/vittominacori)\r\n@dev Interface for any contract that wants to support approveAndCall\r\n from ERC1363 token contracts as defined in\r\n https://github.com/ethereum/EIPs/issues/1363\r",
			"fullyImplemented" : false,
			"id" : 1167,
