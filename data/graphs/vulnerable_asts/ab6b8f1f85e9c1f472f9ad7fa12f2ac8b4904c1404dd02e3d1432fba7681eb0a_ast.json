								"operations" : "{\n    let len := mload(_s)\n    let p := add(_s, 0x20)\n    if eq(len, 0)\n    {\n        revert(0, 0)\n    }\n    if gt(len, 100)\n    {\n        revert(0, 0)\n    }\n    let b := byte(0, mload(add(_s, 0x20)))\n    if lt(b, 0x21)\n    {\n        revert(0, 0)\n    }\n    b := byte(0, mload(add(p, sub(len, 1))))\n    if lt(b, 0x21)\n    {\n        revert(0, 0)\n    }\n    for {\n        let end := add(p, len)\n    }\n    lt(p, end)\n    {\n        p := add(p, 1)\n    }\n    {\n        b := byte(0, mload(p))\n        if lt(b, 0x5b)\n        {\n            if gt(b, 0x40)\n            {\n                mstore8(p, add(b, 32))\n            }\n        }\n    }\n}",
